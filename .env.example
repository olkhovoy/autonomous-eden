# MCS Configuration
# Copy to .env and edit for your environment

# === Ollama (LLM backend) ===
# Address of your Ollama instance
OLLAMA_HOST=localhost
# Full URLs (derived from OLLAMA_HOST, override if needed)
OLLAMA_GENERATE_URL=http://${OLLAMA_HOST}:11434/api/generate
OLLAMA_EMBED_URL=http://${OLLAMA_HOST}:11434/api/embeddings

# === Models ===
# Model for EVE (standard consciousness)
EVE_MODEL=llama3:8b
# Model for ADAM (Garden of Eden)
ADAM_MODEL=forzer/GigaChat3-10B-A1.8B

# === Stable Diffusion (optional, for SelfImage module) ===
# Set to empty to disable
SD_HOST=
# SD_HOST=localhost:7860

# === GitHub (optional, for GitHubEyes module) ===
GITHUB_TOKEN=

# === Soul IDs ===
EVE_SOUL_ID=eve
ADAM_SOUL_ID=adam

# === Timing ===
# Consciousness loop tick interval (seconds)
EVE_TICK_INTERVAL=10
ADAM_TICK_INTERVAL=25
# Environmental pressure interval (seconds)
PRESSURE_INTERVAL=300

# === Resource Limits ===
# Qdrant memory limit
QDRANT_MEMORY_LIMIT=512m
