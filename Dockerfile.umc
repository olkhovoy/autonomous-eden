FROM python:3.12-slim

WORKDIR /app

ARG GGGP_PYPI_SPEC=gggp
RUN pip install --no-cache-dir requests && \
    if [ -n "$GGGP_PYPI_SPEC" ]; then \
      pip install --no-cache-dir "$GGGP_PYPI_SPEC" || echo "[WARN] Could not install $GGGP_PYPI_SPEC"; \
    fi

COPY umc_core /app/umc_core
COPY engine /app/engine
COPY experiments /app/experiments
COPY gggp_bundle /app/gggp_bundle
COPY tools /app/tools

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python", "engine/core/soul_memory_node.py"]
